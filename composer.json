{
    "name": "coisa/console-app",
    "description": "PHP 8.3 console sandbox and application template for Fast Forward",
    "type": "project",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Felipe Sayão Lobato Abreu",
            "email": "github@felipeabreu.com.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-PDO": "*",
        "ext-pdo_mysql": "*",
        "fast-forward/container": "^1.10.1",
        "fast-forward/config": "^1.7.4",
        "monolog/monolog": "^3.0",
        "symfony/console": "^7.4",
        "peppeocchi/php-cron-scheduler": "^4.0",
        "fast-forward/event-dispatcher": "^1.1.2"
    },
    "autoload": {
        "psr-4": {
            "Console\\": "src/"
        }
    },
    "scripts": {
        "post-create-project-cmd": "cp -v --no-clobber .env.example .env",
        "test": "php tests/smoke.php"
    }
}
